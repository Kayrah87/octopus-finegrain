# --- Required -------------------------------------------------------------
# Octopus Energy API key: https://octopus.energy/dashboard/new/accounts/personal-details/api-access
OCTOPUS_API_KEY=
# Account number, e.g. A-1234ABCD
OCTOPUS_ACCOUNT_NUMBER=

# --- Optional: live data (Octopus Home Mini) ------------------------------
# Key used for the Kraken GraphQL API. Usually the same value as OCTOPUS_API_KEY.
# Leave empty to disable live features; the dashboard works fine without it.
OCTOPUS_GRAPHQL_API_KEY=

# --- Optional: login ------------------------------------------------------
# If BOTH are set, the dashboard requires login. If either is empty, no login.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# --- Optional: tuning -----------------------------------------------------
DASHBOARD_PORT=8080
SYNC_INTERVAL_MINUTES=60
TZ=Europe/London
